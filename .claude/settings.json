{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt --check *)",
      "Bash(npm test *)",
      "Bash(npm run build *)",
      "Bash(npm run test *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet format --verify-no-changes *)",
      "Bash(node --test *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(cargo build *)",
      "PowerShell(cargo check *)",
      "PowerShell(cargo test *)",
      "PowerShell(cargo clippy *)",
      "PowerShell(cargo fmt --check *)",
      "PowerShell(npm test *)",
      "PowerShell(npm run build *)",
      "PowerShell(npm run test *)",
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet test *)",
      "PowerShell(dotnet format --verify-no-changes *)",
      "PowerShell(node --test *)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*.snk)",
      "Read(**/secrets/**)",
      "Read(**/.npmrc)",
      "Read(~/.ssh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.config/glab-cli/**)",
      "Read(~/AppData/Roaming/Microsoft/UserSecrets/**)",
      "Read(~/AppData/Roaming/NuGet/NuGet.Config)",
      "Read(~/.microsoft/usersecrets/**)",
      "Edit(/docs/input/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf ..)",
      "Bash(rm -rf ../)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(Remove-Item * ~)",
      "PowerShell(Remove-Item * $env:USERPROFILE)",
      "PowerShell(Remove-Item * ..)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci *)",
      "Bash(npm add *)",
      "Bash(npx *)",
      "Bash(pnpm add *)",
      "Bash(pnpm install *)",
      "Bash(yarn add *)",
      "Bash(cargo add *)",
      "Bash(cargo install *)",
      "Bash(dotnet add *)",
      "Bash(dotnet tool install *)",
      "Bash(dotnet workload install *)",
      "Bash(rustup component add *)",
      "Bash(rustup toolchain install *)",
      "Bash(winget install *)",
      "Bash(pip install *)",
      "Bash(claude plugin install *)",
      "Bash(claude mcp add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(npm ci *)",
      "PowerShell(npm add *)",
      "PowerShell(npx *)",
      "PowerShell(pnpm add *)",
      "PowerShell(pnpm install *)",
      "PowerShell(yarn add *)",
      "PowerShell(cargo add *)",
      "PowerShell(cargo install *)",
      "PowerShell(dotnet add *)",
      "PowerShell(dotnet tool install *)",
      "PowerShell(dotnet workload install *)",
      "PowerShell(rustup component add *)",
      "PowerShell(rustup toolchain install *)",
      "PowerShell(winget install *)",
      "PowerShell(pip install *)",
      "PowerShell(claude plugin install *)",
      "PowerShell(claude mcp add *)",
      "PowerShell(Install-Module *)",
      "PowerShell(Install-Package *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-inputs.mjs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-tests.mjs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-delete.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-on-edit.mjs"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true
  }
}
