# Normalize line endings in the repository; checkout follows the platform.
* text=auto

# Scripts run by Node, Git Bash or CI: always LF
*.mjs text eol=lf
*.cjs text eol=lf
*.js text eol=lf
*.sh text eol=lf

# Source and config files: always LF, so Prettier and rustfmt checks pass on Windows
*.ts text eol=lf
*.tsx text eol=lf
*.mts text eol=lf
*.cts text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.rs text eol=lf
*.toml text eol=lf

# Windows-only scripts and Visual Studio solutions: always CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.sln text eol=crlf

# Binary assets (icons, mocks, fonts)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.woff binary
*.woff2 binary
